let tempo = 98
let ms val = val * tempo / 240000
setcps (tempo / 60 / 4)

let hat = sound "hh"
let ohat = sound "hh:7"
let master = (|* gain 0.8)

:{
d1  $ master $ (ms 2 ~>)
		$ struct "[[t ~ ~ ~] [~ ~ ~ ~] [~ ~ t ~] [~ ~ ~ ~] [t ~ ~ ~] [~ ~ ~ ~] [~ ~ t ~] [~ t ~ ~]]/2" (s "mykick")
		# lpf 4000
		# gain 1.12
		# hpf 70
:}

:{
d2  $ master $ struct "[[~ ~ ~ ~] [t ~ ~ ~] [~ ~ ~ ~] [t ~ ~ ~]]" (s "dasnare")
		# lpf 4000
		# gain 1.04
		# nudge (range 0 0.02 rand)
:}

:{
d3  $ master $ swingBy 0.5 4 $ (ms 20 <~)
		$ struct "[[t t ~ t] [t t t t] [t t t t] [t t ~ ~]*2]/2" hat
		# gain 0.9
		# crush 5
		# room 0.1
		# nudge (range 0 0.03 rand)
		# lpf 3200
:}

:{
d4  $ master $ (ms 20 <~)
		$ struct "[[~ ~ t ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~]]/2" ohat
		# gain 0.9
		# room 2
		# lpf 4000
		# crush 7
:}
