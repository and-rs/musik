let tempo = 92
let ms val = val * tempo / 240000
setcps (tempo / 60 / 4)

let hat = sound "hh"
let ohat = sound "hh:7"
let kick = sound "mykick"
let snare = sound "sn:17"

:{
d1  $ (ms 4 ~>)
    $ struct "[[t ~ ~ ~] [~ ~ ~ ~] [~ ~ t ~] [~ ~ ~ ~] [t ~ ~ ~] [~ ~ ~ ~] [~ ~ t ~] [~ t ~ ~]]/2" kick
    # gain 1.2 # crush 6
:}

d2  $ struct "[[~ ~ ~ ~] [t ~ ~ ~] [~ ~ ~ ~] [t ~ ~ ~]]" snare # gain 1 # crush 4

:{
d3  $ swingBy 0.5 4 $ (ms 20 <~) 
    $ struct "[[t t ~ t] [t t t t] [t t t t] [t t ~ ~]*2]/2" hat
    # gain 1
    # crush 5
    # room 0.6
:}

:{
d4  $ struct "[[~ ~ t ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~]]/2" ohat
    # gain 1
    # room 2
:}
