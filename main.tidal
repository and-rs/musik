let tempo = 38
let ms val = val * tempo / 240000
setcps (tempo / 60 / 4)

let hat = sound "hh"
let ohat = sound "hh:7"
let kick = sound "bd:10"
let snare = sound "sn:17"

d1 $ (ms 14 <~) $ struct "[t ~ ~ ~] [~ t ~ ~] [t t ~ ~] [~ ~ t ~]" kick # gain 1
d2              $ struct "[~ ~ t ~] [~ ~ t ~] [~ ~ t ~] [~ ~ t ~]" snare # gain 0.8

d3 $ (ms 20 <~) $ struct "[t t t t] [t t t ~] [t t t t] [t t t ~]" hat
d4              $ struct "[~ ~ ~ ~] [~ ~ ~ t] [~ ~ ~ ~] [~ ~ ~ t]" ohat # gain 1.1
