let ms t v = pure (toRational (v * t / 240000 :: Double))
let master = (|* gain 1.2)
let tempoBpm = 98 :: Double
let barsPerSection = 8 :: Time

let hat = sound "hh:8"
let ohat = sound "hh:7"
let percSound = sound "hh:16"

:{
data Beat = Beat
		{ swg   :: Pattern Time
		, loose :: Pattern Double
		, kick  :: Pattern Bool
		, snare :: Pattern Bool
		, ghost :: Pattern Bool
		, hats  :: Pattern Bool
		, perc  :: Pattern Bool
		, ohats :: Pattern Bool
		}
:}

:{
kickPart b = master $ (ms tempoBpm 2 ~>)
		$ struct (kick b) (s "mykick")
		# orbit 0
		# gain 1.2
		# lpf 8000
		# hpf 80

snarePart b = master $ struct (snare b) (s "dasnare")
		# orbit 0
		# lpf 6000
		# gain 1.04
		# nudge (range 0 (loose b * 2) rand)

hatPart b = master $ swingBy (swg b) 4 $ (ms tempoBpm 20 <~)
		$ struct (hats b) hat
		# orbit 0
		# room 0.2
		# nudge (range 0 0.03 rand)
		# lpf 4200
		# gain 1.5

openHatPart b = master $ (ms tempoBpm 20 <~)
		$ struct (ohats b) ohat
		# orbit 0
		# gain 0.9
		# room 2
		# lpf 4000
		# crush 6

ghostPart b = master $ struct (ghost b) (s "dasnare")
		# orbit 0
		# lpf 4000
		# gain 0.32
		# nudge (range 0 0.02 rand)

percPart b = master $ struct (perc b) percSound
		# orbit 0
		# gain 0.7
		# coarse 4
		# att 0.1

play b = do
	setcps (pure (tempoBpm / 60 / 4))
	d1 $ kickPart b
	d2 $ snarePart b
	d3 $ hatPart b
	d4 $ openHatPart b
	d5 $ ghostPart b
	d6 $ percPart b
:}

:{
mainB = Beat
		{ swg   = 0.5
		, loose = 0.01
		, kick  = "[[t ~ ~ ~] [~ ~ ~ ~] [~ ~ t ~] [~ ~ ~ ~] [t ~ ~ ~] [~ ~ ~ ~] [~ ~ t ~] [~ t ~ ~]]/2"
		, snare = "[[~ ~ ~ ~] [t ~ ~ ~] [~ ~ ~ ~] [t ~ ~ ~]]"
		, ghost = "~"
		, hats  = "[[t t ~ t] [t t t t] [t t t t] [t t ~ ~]*2]/2"
		, perc  = "[[~ ~ t ~] [~ ~ ~ ~] [~ t ~ ~] [~ ~ ~ ~]]/2"
		, ohats = "[[~ ~ t ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~]]/2"
		}
:}

:{
boomB = Beat
		{ swg   = 0.5
		, loose = 0.01
		, kick  = "[[t ~ t ~] [~ ~ t ~] [~ ~ t ~] [~ ~ ~ ~] [t ~ t ~] [~ ~ t ~] [~ ~ t ~] [~ ~ ~ t]]/2"
		, snare = "[[~ ~ ~ ~] [t ~ ~ ~] [~ ~ ~ ~] [t ~ ~ ~]]"
		, ghost = "~"
		, hats  = "[t ~ t ~] [t ~ t t] [t ~ t ~] [t ~ t ~]"
		, perc  = "[[~ ~ ~ ~] [~ ~ ~ ~] [~ ~ t ~] [~ ~ ~ t]]/2"
		, ohats = "[[~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ t ~]]/2"
		}
:}

:{
dillaB = Beat
		{ swg   = 0
		, loose = 0.02
		, kick  = "[[t ~ ~ ~] [~ ~ ~ t] [~ ~ t ~] [~ ~ ~ ~] [t ~ ~ ~] [~ ~ ~ t] [~ ~ t ~] [~ ~ ~ t]]/2"
		, snare = "[[~ ~ ~ ~] [t ~ ~ ~] [~ ~ ~ ~] [t ~ ~ ~]]"
		, ghost = "~"
		, hats  = "[[t t t t] [t t ~ t] [t t t t] [t ~ t t]]"
		, perc  = "[[~ ~ ~ t] [~ ~ ~ ~] [~ ~ ~ ~] [t ~ ~ ~]]/2"
		, ohats = "[[~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ t ~]]"
		}
:}

:{
ghostB = Beat
		{ swg   = 0.5
		, loose = 0.01
		, kick  = "[[t ~ ~ ~] [~ ~ t ~] [~ ~ ~ ~] [~ t ~ ~] [t ~ ~ ~] [~ ~ t ~] [~ ~ ~ ~] [~ ~ t ~]]/2"
		, snare = "[[~ ~ ~ ~] [t ~ ~ ~] [~ ~ ~ ~] [t ~ ~ ~]]"
		, ghost = "[[~ ~ ~ t] [~ ~ t ~] [~ t ~ ~] [~ ~ ~ t]]"
		, hats  = "[[t t t t] [t t t t] [t t t t] [t t t t]]"
		, perc  = "[[~ ~ t ~] [~ ~ ~ ~] [~ ~ ~ t] [~ ~ ~ ~]]/2"
		, ohats = "[[~ ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ ~ t ~]]"
		}
:}

:{
sections p = seqP [(0, barsPerSection, p mainB), (barsPerSection, barsPerSection * 2, p boomB), (barsPerSection * 2, barsPerSection * 3, p dillaB), (barsPerSection * 3, barsPerSection * 4, p ghostB)]

arrange = do
	hush
	resetCycles
	setcps (pure (tempoBpm / 60 / 4))
	d1 $ sections kickPart
	d2 $ sections snarePart
	d3 $ sections hatPart
	d4 $ sections openHatPart
	d5 $ sections ghostPart
	d6 $ sections percPart
:}

arrange
